# Next.js Public Config
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/yourguild
NEXT_PUBLIC_APP_NAME=Guild Glory Bot

# Backend API (Server-side only)
API_SECRET_KEY=your-secret-key-here

# Payment Gateway (Never expose in frontend)
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_SECRET_KEY=your-stripe-secret

# JWT Secret (Server-side only)
JWT_SECRET=your-jwt-secret-key

# Database (If using)
DATABASE_URL=your-database-url

# Admin Email
ADMIN_EMAIL=admin@guild-glory-bot.com
